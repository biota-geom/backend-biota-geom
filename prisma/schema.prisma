// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  isAdmin      Boolean   @default(false) @map("is_admin")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)

  @@map("users")
}

enum EsgPillar {
  AMBIENTAL
  SOCIAL
  GOVERNANCA

  @@map("esg_pillar")
}

model Sector {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sectors")
}

model EsgMetric {
  id            String    @id @default(uuid(7)) @db.Uuid
  griStandardId String?   @map("gri_standard_id") @db.Uuid
  // Nulo = métrica global (visível a todos). Preenchido = métrica do cliente.
  // TODO: ao habilitar métricas por cliente, migrar `name @unique` para
  // único-por-cliente (índice parcial nas globais + @@unique([customerId, name])).
  customerId    String?   @map("customer_id") @db.Uuid
  name          String    @unique @db.VarChar(120)
  unit          String    @db.VarChar(30)
  pillar        EsgPillar
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("esg_metric")
}
