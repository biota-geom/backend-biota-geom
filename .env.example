NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://biota:biota@localhost:5432/biota_geom?schema=public"
# Banco usado pelos testes de integração e e2e. O globalSetup do Jest cria
# esse banco se ele ainda não existir e injeta a URL em DATABASE_URL.
# Se estiver vazia ou ausente, os testes caem de volta na DATABASE_URL acima.
TEST_DATABASE_URL="postgresql://biota:biota@localhost:5432/biota_geom_test?schema=public"

# JWT signing secrets — generate distinct values per environment, e.g.:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-access
JWT_REFRESH_SECRET=replace-with-a-random-secret-at-least-32-characters-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=biota-geom-api
JWT_AUDIENCE=biota-geom-web

# Only emails on this domain are allowed to self-register.
AUTH_ALLOWED_EMAIL_DOMAIN=biotageom.com.br

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# Public origin this API is served from — used to build absolute URLs for
# locally-stored files (e.g. license documents).
APP_BASE_URL=http://localhost:3000

# File storage for uploaded documents (license PDFs, etc). "local" writes to
# LOCAL_STORAGE_DIR and serves files back from this API. "s3" uploads to the
# AWS bucket below — fill in the AWS_* vars and flip this to activate it,
# no code change needed.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage

# Required only when STORAGE_DRIVER=s3.
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: S3-compatible endpoint (e.g. MinIO/LocalStack) for local testing.
AWS_S3_ENDPOINT=
# Optional: serve object URLs from a CDN/custom domain instead of the default
# https://<bucket>.s3.<region>.amazonaws.com/<key>.
AWS_S3_PUBLIC_URL_BASE=
