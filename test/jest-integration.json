{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "\\.integration-spec\\.ts$",
  "globalSetup": "<rootDir>/global-setup.ts",
  "setupFiles": ["reflect-metadata", "<rootDir>/../src/jest.setup-env.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": ["node_modules/(?!(@nestjs/jwt|jsonwebtoken)/)"]
}
