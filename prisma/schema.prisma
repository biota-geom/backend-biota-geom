// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  isAdmin      Boolean   @default(false) @map("is_admin")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)

  esgMetrics        EsgMetric[]
  // Companies this account owns. A User is the consultancy that subscribes to
  // the system (the tenant); a Customer is a company/site it looks after.
  customers         Customer[]
  uploadedDocuments Document[]  @relation("DocumentUploader")
  deletedDocuments  Document[]  @relation("DocumentDeleter")

  @@map("users")
}

enum DocumentType {
  CPF
  CNPJ

  @@map("document_type")
}

enum AddressType {
  BILLING
  SHIPPING

  @@map("address_type")
}

model Customer {
  id           String       @id @default(uuid(7)) @db.Uuid
  name         String       @db.VarChar(255)
  // Unique per owner, not globally: two different consultancies may legitimately
  // serve the same company, so the duplicate check only looks at the logged-in
  // owner's own portfolio (see @@unique below).
  document     String       @db.VarChar(50)
  documentType DocumentType @map("document_type")
  // Optional: the company registration form collects the environmental
  // contact (ownerName/ownerEmail) but not the company's own address details
  // or switchboard, so these are filled in later when they are known.
  email        String?      @db.VarChar(255)
  ownerName    String       @map("owner_name") @db.VarChar(255)
  ownerEmail   String       @map("owner_email") @db.VarChar(255)
  ownerPhone   String?      @map("owner_phone") @db.VarChar(50)
  isActive     Boolean      @default(true) @map("is_active")
  isDeleted    Boolean      @default(false) @map("is_deleted")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updatad_at") @db.Timestamptz(3)

  // Tenant owner: the User (consultancy) that registered this company. Every
  // read and write under /customers is scoped by it, so a customer belonging
  // to another owner is indistinguishable from one that does not exist.
  // Not to be confused with ownerName/ownerEmail/ownerPhone above, which
  // describe the company's own contact person and are not system accounts.
  // onDelete: Restrict — deleting a User must not silently drop its portfolio.
  ownerUserId String @map("owner_user_id") @db.Uuid
  ownerUser   User   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  addressId String?          @unique @map("address_id") @db.Uuid
  address   CustomerAddress? @relation(fields: [addressId], references: [id], onDelete: Cascade)

  sectorId String? @map("sector_id") @db.Uuid
  sector   Sector? @relation(fields: [sectorId], references: [id])

  monitoredEsgMetrics CustomerEsgMetric[]
  licenses            License[]
  esgIndicatorRecords EsgIndicatorRecord[]
  documents           Document[]
  documentFolders     DocumentFolder[]
  alerts              Alert[]

  @@unique([ownerUserId, document])
  @@map("customers")
}

model CustomerAddress {
  id          String      @id @default(uuid(7)) @db.Uuid
  type        AddressType
  street      String?     @db.VarChar(255)
  number      String?     @db.VarChar(50)
  city        String      @db.VarChar(100)
  state       String      @db.VarChar(100)
  postalCode  String?     @map("postal_code") @db.VarChar(20)
  countryCode String      @map("country_code") @db.VarChar(10)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer?

  @@map("customer_address")
}

enum EsgPillar {
  AMBIENTAL
  SOCIAL
  GOVERNANCA

  @@map("esg_pillar")
}

model Sector {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customers Customer[]

  @@map("sectors")
}

// GRI catalog (e.g. "GRI 303-3 Water withdrawal"). Global, not per tenant.
model GriStandard {
  id          String    @id @default(uuid(7)) @db.Uuid
  code        String    @unique @db.VarChar(30)
  name        String    @db.VarChar(255)
  pillar      EsgPillar
  description String?   @db.VarChar(1000)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  esgMetrics EsgMetric[]

  @@map("gri_standard")
}

model EsgMetric {
  id            String       @id @default(uuid(7)) @db.Uuid
  griStandardId String?      @map("gri_standard_id") @db.Uuid
  // onDelete: SetNull — removing a GRI entry from the catalog must not drop
  // the metrics already in use; they just lose the reference.
  griStandard   GriStandard? @relation(fields: [griStandardId], references: [id], onDelete: SetNull)
  // Nulo = métrica global (visível a todos). Preenchido = métrica do cliente.
  // TODO: ao habilitar métricas por cliente, migrar `name @unique` para
  // único-por-cliente (índice parcial nas globais + @@unique([customerId, name])).
  customerId    String?      @map("customer_id") @db.Uuid
  customer      User?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name          String       @db.VarChar(120)
  unit          String       @db.VarChar(30)
  pillar        EsgPillar
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  customerLinks    CustomerEsgMetric[]
  indicatorRecords EsgIndicatorRecord[]

  @@unique([customerId, name])
  @@index([griStandardId])
  @@map("esg_metric")
}

model CustomerEsgMetric {
  customerId  String   @map("customer_id") @db.Uuid
  esgMetricId String   @map("esg_metric_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  esgMetric EsgMetric @relation(fields: [esgMetricId], references: [id], onDelete: Restrict)

  @@id([customerId, esgMetricId])
  @@index([esgMetricId])
  @@map("customer_esg_metrics")
}

model Document {
  id           String    @id @default(uuid(7)) @db.Uuid
  title        String    @db.VarChar(255)
  documentDate DateTime  @map("document_date") @db.Date
  fileUrl      String    @map("file_url") @db.VarChar(2048)
  fileName     String    @map("file_name") @db.VarChar(255)
  mimeType     String    @map("mime_type") @db.VarChar(255)
  sizeBytes    Int       @map("size_bytes")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  uploadedById String @map("uploaded_by") @db.Uuid
  uploadedBy   User   @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  deletedById String? @map("deleted_by") @db.Uuid
  deletedBy   User?   @relation("DocumentDeleter", fields: [deletedById], references: [id], onDelete: Restrict)

  folderId String?         @map("folder_id") @db.Uuid
  folder   DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([customerId, deletedAt, documentDate(sort: Desc), createdAt(sort: Desc)])
  @@index([folderId, deletedAt, documentDate(sort: Desc), createdAt(sort: Desc)])
  @@index([uploadedById])
  @@map("document")
}

model DocumentFolder {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  parentId  String?          @map("parent_id") @db.Uuid
  parent    DocumentFolder?  @relation("DocumentFolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  DocumentFolder[] @relation("DocumentFolderChildren")
  documents Document[]

  @@unique([customerId, parentId, name])
  @@index([customerId, parentId, name])
  @@map("document_folder")
}

// Kept English on purpose (see AGENTS.md: domain/infra stay English-only).
// The PT-BR labels ("Regular"/"Atenção"/"Vencida") required by the API
// contract are produced at the presentation layer, not stored here.
enum LicenseStatus {
  REGULAR
  ATTENTION
  EXPIRED
  ARCHIVED

  @@map("license_status")
}

enum LicenseConditionStatus {
  REGULAR
  ATTENTION
  RISK

  @@map("license_condition_status")
}

enum ConditionType {
  INFORMATIVE
  PERIODIC

  @@map("condition_type")
}

enum ConditionPeriodicity {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL

  @@map("condition_periodicity")
}

// Fulfillment lifecycle of a condition (US16), independent from the risk
// status above, which feeds the customer compliance counters.
enum ConditionStatus {
  FULFILLED
  IN_PROGRESS
  OVERDUE

  @@map("condition_status")
}

model IssuingAgency {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique @db.VarChar(150)
  acronym   String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("issuing_agencies")
}

model License {
  id                String        @id @default(uuid(7)) @db.Uuid
  type              String        @db.VarChar(50)
  processNumber     String        @map("process_number") @db.VarChar(255)
  issueDate         DateTime      @map("issue_date") @db.Timestamptz(3)
  expirationDate    DateTime      @map("expiration_date") @db.Timestamptz(3)
  // Computed server-side at creation time from expirationDate — never
  // accepted from a client. See CreateLicenseUseCase.
  status            LicenseStatus
  // Absolute URL of the uploaded PDF. Local storage or S3 depending on
  // STORAGE_DRIVER — the column just holds whatever URL that driver returns.
  documentUrl       String        @map("document_url") @db.VarChar(2048)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  previousLicenseId String?       @map("previous_license_id") @db.Uuid

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  issuingAgency String @map("issuing_agency") @db.VarChar(150)

  conditions      LicenseCondition[]
  previousLicense License?           @relation("LicenseRenewalHistory", fields: [previousLicenseId], references: [id], onDelete: SetNull)
  renewals        License[]          @relation("LicenseRenewalHistory")

  // Legislation the license is grounded on. Optional: licenses registered
  // before the legislation catalog existed have none.
  legislationId String?      @map("legislation_id") @db.Uuid
  legislation   Legislation? @relation(fields: [legislationId], references: [id], onDelete: SetNull)

  alerts Alert[]

  @@index([customerId])
  @@index([previousLicenseId])
  @@index([legislationId])
  @@map("licenses")
}

model LicenseCondition {
  id                      String                 @id @default(uuid(7)) @db.Uuid
  name                    String                 @map("title") @db.VarChar(160)
  environmentalDescriptor String                 @map("environmental_descriptor") @db.VarChar(120)
  description             String?                @db.VarChar(4095)
  responsibleAgency       String?                @map("responsible_agency") @db.VarChar(150)
  responsibleName         String?                @map("responsible_name") @db.VarChar(255)
  conditionType           ConditionType?         @map("condition_type")
  periodicity             ConditionPeriodicity?
  deadline                DateTime?              @db.Timestamptz(3)
  dueDate                 DateTime               @map("due_date") @db.Timestamptz(3)
  alertDate               DateTime?              @map("alert_date") @db.Timestamptz(3)
  completionDate          DateTime?              @map("completion_date") @db.Timestamptz(3)
  status                  LicenseConditionStatus @default(REGULAR)
  conditionStatus         ConditionStatus        @default(IN_PROGRESS) @map("condition_status")
  hasDelivery             Boolean                @default(true) @map("has_delivery")
  isViolated              Boolean                @default(false) @map("is_violated")
  // Order of the condition inside its license, read by the item numbering.
  // Rows written before this column existed all hold 0 and keep their
  // created_at order as the tie-break.
  position                Int                    @default(0)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  licenseId String  @map("license_id") @db.Uuid
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  alerts Alert[]

  @@index([licenseId])
  @@index([dueDate])
  @@map("license_condition")
}

enum GovernmentSphere {
  FEDERAL
  STATE
  MUNICIPAL

  @@map("government_sphere")
}

// Global legislation catalog fed by the Biota-Geom staff (Epic 7 — Radar).
model Legislation {
  id              String           @id @default(uuid(7)) @db.Uuid
  title           String           @db.VarChar(255)
  // Official act number, e.g. "491/2018". Free text: formats vary by sphere.
  number          String           @db.VarChar(50)
  sphere          GovernmentSphere
  publicationDate DateTime         @map("publication_date") @db.Date
  summary         String?          @db.VarChar(4095)
  sourceUrl       String?          @map("source_url") @db.VarChar(2048)
  // Highlights recently published acts in the radar feed.
  isNew           Boolean          @default(true) @map("is_new")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  licenses License[]
  alerts   Alert[]

  @@index([publicationDate(sort: Desc)])
  @@map("legislation")
}

enum AlertType {
  LICENSE_EXPIRATION
  CONDITION_DUE
  NEW_LEGISLATION

  @@map("alert_type")
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH

  @@map("alert_severity")
}

enum AlertStatus {
  OPEN
  READ
  RESOLVED

  @@map("alert_status")
}

// Notification about a customer. Always scoped to the customer; the optional
// license / condition / legislation say which record raised it.
model Alert {
  id        String        @id @default(uuid(7)) @db.Uuid
  type      AlertType
  severity  AlertSeverity
  title     String        @db.VarChar(160)
  message   String        @db.VarChar(1000)
  dueDate   DateTime?     @map("due_date") @db.Timestamptz(3)
  status    AlertStatus   @default(OPEN)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  licenseId String?  @map("license_id") @db.Uuid
  license   License? @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  licenseConditionId String?           @map("license_condition_id") @db.Uuid
  licenseCondition   LicenseCondition? @relation(fields: [licenseConditionId], references: [id], onDelete: Cascade)

  legislationId String?      @map("legislation_id") @db.Uuid
  legislation   Legislation? @relation(fields: [legislationId], references: [id], onDelete: Cascade)

  @@index([customerId, status])
  @@index([licenseId])
  @@index([licenseConditionId])
  @@index([legislationId])
  @@map("alert")
}

// Monthly operational indicators a customer reports (US11). One row per
// customer + indicator + month; saving the same month again updates the row.
// The indicator is a catalog entry (EsgMetric); the ones a customer reports
// are the ones linked to it through CustomerEsgMetric.
model EsgIndicatorRecord {
  id             String   @id @default(uuid(7)) @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  indicatorId    String   @map("indicator_id") @db.Uuid
  // Always the first day of the month (a DATE, no time zone).
  referenceMonth DateTime @map("reference_month") @db.Date
  value          Decimal  @db.Decimal(18, 4)
  // Where the value came from (e.g. a utility bill or meter reading).
  source         String?  @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  indicator EsgMetric @relation(fields: [indicatorId], references: [id], onDelete: Restrict)

  @@unique([customerId, indicatorId, referenceMonth], map: "esg_indicator_record_customer_indicator_month_key")
  @@index([indicatorId])
  @@map("esg_indicator_record")
}
